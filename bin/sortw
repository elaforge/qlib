#!/usr/bin/env python3
# Do by-word sort of the input, for vim selection.

import sys
import re

if len(sys.argv) == 1:
    sep = None
elif len(sys.argv) == 2:
    sep = sys.argv[1]
else:
    sys.exit("usage: sortw [sep]")

input = sys.stdin.read()
if sep:
    words = re.split(r'\s*' + re.escape(sep) + r'\s*', input)
else:
    words = input.split()

joiner = ' ' + sep + ' ' if sep else ' '
print(joiner.join(sorted(words)))
