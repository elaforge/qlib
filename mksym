#!/usr/bin/env zsh

# set -eu

# Set this by hand to link a different qlib.  However, zshenv will still find
# the first match.
if [[ -z $qlib ]]; then
    echo $0: qlib not set
    # exit 1
fi

if [[ -e $qlib/sys/$host/xsession ]]; then
    use_x=t
else
    use_x=
fi

cd
dotfiles=(
    .inputrc .vim .zlogin .zshenv .zshrc .haskeline .ghci .editrc
    .tmux.conf
)
if [[ -n $use_x ]]; then
    dotfiles+=(.fvwm2rc)
fi
for fn in $dotfiles; do
    ln -fs $qlib/dotfiles/$fn
done

mkdir -p .config
# Merge with any local ~/.config files.
for fn in $qlib/dotfiles/.config/*(N); do
    ln -fs $fn ~/.config
done

# clean up the old way
rm -f ~/.gitconfig

if [[ ! -e bin ]]; then
    ln -s $qlib/bin
fi

if [[ -n $use_x ]]; then
    ln -sf $qlib/sys/$host/xsession .xsession
    ln -sf .xsession .xinitrc
fi
