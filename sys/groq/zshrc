function _grep {
    local dir
    local type=$1
    shift
    if [[ -d $1 ]]; then
        dir=$1
        shift
    else
        dir=
    fi
    rg --type $type "$@" $dir
}

function hgrep { _grep haskell "$@" }
function ngrep { _grep nix "$@" }
function pgrep { _grep py "$@" }
function cgrep { rg --type c --type cpp "$@" }

function verbose {
    GROQ_LOG_CONFIG=severity=debug,stderr-only "$@"
}

### bake

function vbake {
    verbose bake "$@"
}

function lbake {
    _result_local/Groq/Infra/Bake/bake "$@"
}
function vlbake {
    verbose lbake "$@"
}
function lbrake {
    _result_local/Groq/Infra/Brake/brake "$@"
}
function vlbrake {
    verbose lbrake "$@"
}

function blocal {
    bake build -Lverbose --local --upload=no "$@"
}
function bdump {
    bake build -Ldump --local --upload=no "$@"
}

function gr {
    local flags=(
        --slack
        --update-mr
        # --ci-start
    )
    local extras=()
    case $1 in
    # push) extras=(--label ReleaseUpdate::NotRequired);;
    mr-get) extras=(--format=short)
    esac
    SFT_AUTH_SOCK= command gr $flags $extras "$@"
}

function make-bake {
    ( cd $(g3) && BAKE_UNCLEAN_BUILD=t BRAKE=t Groq/Infra/Bake/make-bake.sh \
        && git add Groq/Infra/Bake/current-version \
        && git commit -am 'bake: update version' \
    )
}

# configure gcloud cmd
export CLOUDSDK_COMPUTE_ZONE=us-west1-a

export LINT_IGNORE_UNTRACKED=true # don't lint untracked files

function c2n {
    if [[ -z $2 ]]; then
        cabal2nix --no-check cabal://$1 > $1.nix && grep 'version =' $1.nix
    else
        cabal2nix --no-check cabal://$1-$2 > $1.nix && grep 'version =' $1.nix
    fi
}

