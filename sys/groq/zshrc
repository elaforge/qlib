function copy-from {
    nix copy --from http://narpile.groq "$@"
}
function copy-to {
    nix copy --to http://narpile.groq "$@"
}

function showd {
    local drv=$(fix-drv $1)
    if [[ -h $drv ]]; then
        drv=$(readlink $drv)
    fi
    case $2 in
    inputDrvs)
        nix derivation show $drv\^\* | jq -r '.[].inputDrvs | keys | join("\n")'
        ;;
    *)
        nix derivation show $drv\^\* | jq --color-output 'del(.[].env.__json)'
        nix derivation show $drv\^\* | jq --color-output '.[].env.__json | fromjson'
        ;;
    esac
}

function showe {
    local drv=$(fix-drv $1)
    if [[ -h $drv ]]; then
        drv=$(readlink $drv)
    fi
    nix derivation show $drv\^\* | jq --color-output '.[].env.__json | fromjson'
}

